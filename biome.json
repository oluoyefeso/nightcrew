{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": ["apps/**", "packages/**", "!**/dist", "!**/migrations", "!**/*.gen.ts", "!**/node_modules"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": {
    "rules": {
      "recommended": true,
      "a11y": { "noStaticElementInteractions": "off", "useSemanticElements": "off" },
      "style": { "noNonNullAssertion": "off" },
      "complexity": { "noImportantStyles": "off" }
    }
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
